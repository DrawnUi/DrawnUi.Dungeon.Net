<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
        <!-- Windows (WinUI), unpackaged: built on Windows only -->
        <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
        <WindowsPackageType>None</WindowsPackageType>

        <ApplicationId>net.drawnui.dungeonrun</ApplicationId>
        <ApplicationTitle>Dungeon Run</ApplicationTitle>
        <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
        <ApplicationVersion>1</ApplicationVersion>

        <OutputType>Exe</OutputType>
        <RootNamespace>DungeonRun</RootNamespace>
        <AssemblyName>DungeonRun</AssemblyName>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>

        <!-- Google Play takes API 24 and up -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
        <!-- the minimum DrawnUi.Maui supports -->
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.2</SupportedOSPlatformVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.19041.0</TargetPlatformMinVersion>
    </PropertyGroup>

    <!--
    No signing settings here: a Debug build for the iOS simulator or Mac Catalyst needs none, and a Debug build for an
    iPhone signs with the developer identity the Mac has (automatic selection). To sign with your own identity, pass
    -p:CodesignKey=... -p:CodesignProvision=... on the command line, or copy Signing.local.props.example to
    Signing.local.props next to this file (it is ignored by git).
    -->
    <Import Project="Signing.local.props" Condition="Exists('Signing.local.props')" />

    <ItemGroup>
        <!-- the DrawnUI icon, as the game's other heads (favicon.ico, icon.ico) -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FEFEFE" />
        <MauiSplashScreen Include="Resources\AppIcon\appiconfg.svg" Color="#FEFEFE" BaseSize="180,180" />
        <!-- the fonts of the web head -->
        <MauiFont Include="..\Dungeon.Web\wwwroot\fonts\*.ttf" Link="Resources\Fonts\%(Filename)%(Extension)" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="10.0.80" />
    </ItemGroup>

    <!-- The DrawnUi source while we develop (branch Cells, with the SKMesh stand-in), not the NuGet. -->
    <ItemGroup>
        <ProjectReference Include="..\..\..\DrawnUi\src\Maui\Addons\DrawnUi.Maui.Game\DrawnUi.Maui.Game.csproj" />
    </ItemGroup>

    <Import Project="..\Dungeon.Shared\Dungeon.Shared.projitems" Label="Shared" />

</Project>
