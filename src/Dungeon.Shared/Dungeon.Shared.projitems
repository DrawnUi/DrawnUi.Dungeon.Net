<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects Condition="'$(MSBuildVersion)' == '' Or '$(MSBuildVersion)' &lt; '16.0'">$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>7a5df50a-8f85-4494-9191-382f65981601</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>DungeonRun</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)Game\World.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Game\Scene.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)Game\Shaders.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)UI\DungeonGame.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)UI\DungeonApp.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)UI\DungeonApp.Tick.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)UI\DungeonApp.Input.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)UI\DungeonApp.Dialogs.cs" />
    <!-- the drawn SkiaShell of the .NET heads; the MAUI head brings its own host (MAUI's SkiaShell is a page) -->
    <Compile Include="$(MSBuildThisFileDirectory)UI\DungeonApp.Shell.cs" Condition="'$(UseMaui)' != 'true'" />
    <Compile Include="$(MSBuildThisFileDirectory)UI\Plate.cs" />
  </ItemGroup>
</Project>
