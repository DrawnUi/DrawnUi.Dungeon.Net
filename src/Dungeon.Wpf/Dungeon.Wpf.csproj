<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <!-- WinExe: no console window -->
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0-windows</TargetFramework>
        <UseWPF>true</UseWPF>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <LangVersion>latest</LangVersion>
        <RootNamespace>DungeonRun</RootNamespace>
        <AssemblyName>DungeonRun</AssemblyName>
        <Title>Dungeon Run</Title>
        <!-- exe, window and taskbar icon -->
        <ApplicationIcon>icon.ico</ApplicationIcon>
    </PropertyGroup>

    <!-- DrawnUI from NuGet, or from a DrawnUi.Net checkout next to this repo with -p:UseDrawnUiSource=true -->
    <ItemGroup Condition="'$(UseDrawnUiSource)' != 'true'">
        <PackageReference Include="DrawnUi.Wpf" Version="$(DrawnUiVersion)" />
        <PackageReference Include="DrawnUi.Wpf.Game" Version="$(DrawnUiVersion)" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseDrawnUiSource)' == 'true'">
        <ProjectReference Include="$(DrawnUiSource)Wpf\Drawnui.Wpf\DrawnUi.Wpf.csproj" />
        <ProjectReference Include="$(DrawnUiSource)Wpf\Addons\DrawnUi.Wpf.Game\DrawnUi.Wpf.Game.csproj" />
    </ItemGroup>

    <Import Project="..\Dungeon.Shared\Dungeon.Shared.projitems" Label="Shared" />

    <!-- The fonts of the web head, next to the exe (this head reads assets from the output folder). -->
    <ItemGroup>
        <Content Include="..\Dungeon.Web\wwwroot\fonts\*.ttf" Link="fonts\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
