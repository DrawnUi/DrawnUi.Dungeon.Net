<Project Sdk="Microsoft.NET.Sdk">

    <!-- Headless allocation and time profile of the game on DrawnUi.Net (raster, desktop .NET): which types a frame
         allocates, on the title and in a run. A dev tool, not shipped. -->
    <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>DungeonRun</RootNamespace>
        <DefineConstants>$(DefineConstants);DRAWNUI_NET</DefineConstants>
    </PropertyGroup>

    <ItemGroup Condition="'$(UseDrawnUiSource)' != 'true'">
        <PackageReference Include="DrawnUi.Net.Game" Version="$(DrawnUiVersion)" />
    </ItemGroup>
    <ItemGroup Condition="'$(UseDrawnUiSource)' == 'true'">
        <ProjectReference Include="$(DrawnUiSource)Net\Addons\DrawnUi.Net.Game\DrawnUi.Net.Game.csproj" />
    </ItemGroup>

    <Import Project="..\..\src\Dungeon.Shared\Dungeon.Shared.projitems" Label="Shared" />

</Project>
